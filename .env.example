NODE_ENV=development
PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mekteb
DB_PASS=
DB_NAME=mekteb_db
# Generate TWO different random secrets, at least 32 bytes each.
# Access JWT signing key. Missing/weak secrets prevent startup.
JWT_SECRET=
# Server-side pepper for hashing opaque refresh credentials (not refresh JWT signing).
JWT_REFRESH_SECRET=
# Positive duration, maximum 15m.
JWT_EXPIRE=15m
# Absolute session lifetime from login; refresh never extends it. Maximum 365d.
JWT_REFRESH_EXPIRE=30d
# Comma-separated exact origins, no trailing slash. HTTPS in production.
# Browser frontend and API must be same-site for the SameSite=Lax refresh cookie.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
# Set only after verifying the exact number of trusted reverse proxy hops.
TRUST_PROXY_HOPS=0
# Optional absolute private env file, set by the process before startup.
# MEKTEB_ENV_FILE=/storage1/mektebpa/mekteb-shared/backend.env
# Absolute persistent directory, outside the code release and public web roots.
# UPLOAD_DIRECTORY=/storage1/mektebpa/mekteb-shared/news-images
# cPanel: external (cron); persistent single-process servers: inline.
PUSH_WORKER_MODE=inline
# Administrator bootstrap reads BOOTSTRAP_ADMIN_USERNAME, BOOTSTRAP_ADMIN_EMAIL,
# BOOTSTRAP_ADMIN_PASSWORD, BOOTSTRAP_ADMIN_FIRST_NAME and BOOTSTRAP_ADMIN_LAST_NAME
# from the invoking process environment. No default admin is created.
# Keep bootstrap passwords out of committed files and command-line arguments.
# Integration tests use MEKTEB_TEST_MYSQL_PORT and MEKTEB_TEST_MYSQL_DIRECTORY
# from the process environment for a separately provisioned, marked disposable instance.

# Web Push (optional). Generate once with npm run push:keys; never commit private keys.
# All three must be configured together. Missing all leaves phone push disabled.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
# Exact reviewed push provider hosts. Default supports Chrome/Android, Firefox and Safari.
# WEB_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com
