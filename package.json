{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --import ./tests/setup.ts --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/mysql.integration.ts",
    "test:functional": "node --import tsx --test tests/integration/functional.integration.ts",
    "test:deployment": "node --import tsx --test tests/integration/deployment.integration.ts",
    "test:legacy": "node --import tsx --test tests/integration/legacy.integration.ts",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "migrate": "tsx scripts/migrate.js",
    "migrate:up": "tsx scripts/migrate.js up",
    "migrate:rollback": "tsx scripts/migrate.js rollback",
    "migrate:status": "tsx scripts/migrate.js status",
    "admin:create": "tsx scripts/create-admin.js",
    "push:keys": "node scripts/push-keys.js",
    "push:work": "node dist/push-worker.js",
    "migrate:production": "node dist/cli/migrate.js",
    "admin:production": "node dist/cli/create-admin.js",
    "check:production": "node dist/cli/preflight.js",
    "release:prepare": "node deploy/prepare-release.cjs",
    "deploy:check": "node deploy/check-https.cjs",
    "security:check": "node deploy/security-check.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/jwt-decode": "^2.2.1",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.1",
    "node-fetch": "^3.3.2",
    "web-push": "^3.6.7",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.6.2",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
